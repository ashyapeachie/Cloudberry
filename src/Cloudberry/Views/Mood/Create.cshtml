@model Cloudberry.Models.MoodEntry

<h2>Track Your Mood ☁️</h2>

<form asp-action="Create" method="post">

    <div>
        <label>Mood</label>

        <select asp-for="Mood">
            <option>Happy 😊</option>
            <option>Good 🙂</option>
            <option>Neutral 😐</option>
            <option>Sad 😔</option>
            <option>Overwhelmed 😣</option>
        </select>
    </div>

    <br />

    <div>
        <label>Note</label>
        <textarea asp-for="Note"></textarea>
    </div>

    <br />

    <button type="submit">
        Save Mood
    </button>

</form>